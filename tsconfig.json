{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@translate": ["./src/common/translate"],
      "@widgets/*": ["./src/common/widgets/*"],
      "@components/*": ["./src/common/components/*"],
      "common/*": ["./src/common/*"]
    }
  },
  "include": ["src"]
}
